{
  "name": "beamer-editor",
  "displayName": "Beamer Editor",
  "description": "Beamer slide previews for VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "ebi-oishii",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:latex",
    "onCommand:beamerEditor.openPreview",
    "onCommand:beamerEditor.export"
  ],
  "contributes": {
    "commands": [
      {
        "command": "beamerEditor.openPreview",
        "title": "Beamer Editor: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "beamerEditor.revealSlideInPreview",
        "title": "Beamer Editor: Reveal Current Slide in Preview"
      },
      {
        "command": "beamerEditor.followCursor.enable",
        "title": "Beamer Editor: Follow Cursor in Preview",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "beamerEditor.followCursor.disable",
        "title": "Beamer Editor: Stop Following Cursor in Preview",
        "icon": "$(sync)"
      },
      {
        "command": "beamerEditor.export",
        "title": "Beamer Editor: Export...",
        "icon": "$(export)"
      },
      {
        "command": "beamerEditor.slides.moveUp",
        "title": "Beamer Editor: Move Slide Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "beamerEditor.slides.moveDown",
        "title": "Beamer Editor: Move Slide Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "beamerEditor.slides.duplicate",
        "title": "Beamer Editor: Duplicate Slide",
        "icon": "$(copy)"
      },
      {
        "command": "beamerEditor.slides.delete",
        "title": "Beamer Editor: Delete Slide",
        "icon": "$(trash)"
      },
      {
        "command": "beamerEditor.slides.insert",
        "title": "Beamer Editor: Insert New Slide",
        "icon": "$(add)"
      },
      {
        "command": "beamerEditor.slides.append",
        "title": "Beamer Editor: Add Slide at End",
        "icon": "$(add)"
      }
    ],
    "configuration": {
      "title": "Beamer Editor",
      "properties": {
        "beamerEditor.managedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.slide.tex"
          ],
          "scope": "resource",
          "description": "Glob patterns for Beamer Editor managed slide files."
        },
        "beamerEditor.preview.followCursor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "ソースのカーソルがあるフレームをプレビューが追従して表示します。プレビュータブのボタンでも切り替えられます。"
        },
        "beamerEditor.preview.lockGroup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "プレビューのエディタグループをロックし、他のファイルがプレビューと同じグループに開かないようにします。ロックはプレビューが初めてフォーカスされたときに掛かります。"
        },
        "beamerEditor.tectonicPath": {
          "type": "string",
          "default": "tectonic",
          "scope": "resource",
          "description": "Path to the Tectonic executable used for PDF export."
        },
        "beamerEditor.pdfExport.timeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 5,
          "maximum": 1800,
          "scope": "resource",
          "description": "Maximum time in seconds to wait for PDF compilation."
        },
        "beamerEditor.preview.compileRawBlocks": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "TikZ などサブセット外のブロックを Tectonic で部分コンパイルし、プレビューのプレースホルダに画像として差し込みます(Workspace Trust が必要)。"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "beamerEditor.openPreview",
          "when": "resourceScheme == file && resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "beamerEditor.followCursor.disable",
          "when": "activeWebviewPanelId == beamerEditor.preview && beamerEditor.followCursor",
          "group": "navigation"
        },
        {
          "command": "beamerEditor.followCursor.enable",
          "when": "activeWebviewPanelId == beamerEditor.preview && !beamerEditor.followCursor",
          "group": "navigation"
        },
        {
          "command": "beamerEditor.export",
          "when": "resourceScheme == file && resourceExtname == .tex && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "beamerEditor.followCursor.enable",
          "when": "!beamerEditor.followCursor"
        },
        {
          "command": "beamerEditor.followCursor.disable",
          "when": "beamerEditor.followCursor"
        },
        {
          "command": "beamerEditor.export",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "beamerEditor.slides.moveUp",
          "when": "beamerEditor.hasSlideOutlineDocument"
        },
        {
          "command": "beamerEditor.slides.moveDown",
          "when": "beamerEditor.hasSlideOutlineDocument"
        },
        {
          "command": "beamerEditor.slides.duplicate",
          "when": "beamerEditor.hasSlideOutlineDocument"
        },
        {
          "command": "beamerEditor.slides.delete",
          "when": "beamerEditor.hasSlideOutlineDocument"
        },
        {
          "command": "beamerEditor.slides.insert",
          "when": "beamerEditor.hasSlideOutlineDocument"
        },
        {
          "command": "beamerEditor.slides.append",
          "when": "beamerEditor.hasSlideOutlineDocument"
        }
      ],
      "webview/title": [
        {
          "command": "beamerEditor.export",
          "when": "webviewId == beamerEditor.preview && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "beamerEditor.slides.moveUp",
          "when": "view == beamerEditor.slides && viewItem == beamerSlide",
          "group": "slides@1"
        },
        {
          "command": "beamerEditor.slides.moveDown",
          "when": "view == beamerEditor.slides && viewItem == beamerSlide",
          "group": "slides@2"
        },
        {
          "command": "beamerEditor.slides.duplicate",
          "when": "view == beamerEditor.slides && viewItem == beamerSlide",
          "group": "slides@3"
        },
        {
          "command": "beamerEditor.slides.delete",
          "when": "view == beamerEditor.slides && viewItem == beamerSlide",
          "group": "slides@4"
        },
        {
          "command": "beamerEditor.slides.insert",
          "when": "view == beamerEditor.slides && viewItem == beamerSlide",
          "group": "slides@5"
        }
      ],
      "view/title": [
        {
          "command": "beamerEditor.slides.append",
          "when": "view == beamerEditor.slides && beamerEditor.hasSlideOutlineDocument",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "beamerEditor.revealSlideInPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId == latex"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "beamerEditor.slides",
          "name": "Beamer Slides"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "beamerEditor.slides",
        "when": "!beamerEditor.hasSlideOutlineDocument",
        "contents": "Open a managed Beamer slide to show its frames."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:integration": "pnpm build && node esbuild.integration.mjs && vscode-test",
    "package": "pnpm build && vsce package --no-dependencies -o beamer-editor.vsix"
  },
  "dependencies": {
    "@beamer-editor/compiler": "workspace:*",
    "@beamer-editor/core": "workspace:*",
    "@beamer-editor/renderer": "workspace:*",
    "@beamer-editor/ui": "workspace:*",
    "katex": "^0.16.47",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "プレビュー・lint はコードを実行しません。PDF 書き出しは Workspace Trust が無い場合に無効化します。",
      "restrictedConfigurations": [
        "beamerEditor.tectonicPath"
      ]
    }
  }
}
